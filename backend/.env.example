# Application
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/hiring_db?schema=public"

# JWT
JWT_ACCESS_SECRET=your_access_secret_min_32_chars_here
JWT_REFRESH_SECRET=your_refresh_secret_min_32_chars_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cookie
COOKIE_SECRET=your_cookie_secret_here

# Frontend
FRONTEND_URL=http://localhost:5173

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM="Hiring System <noreply@company.com>"

# Storage
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# Assessment recordings (private; local by default)
STORAGE_PROVIDER=local
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_ENDPOINT=
STORAGE_FORCE_PATH_STYLE=false
ASSESSMENT_RECORDING_RETENTION_DAYS=90
ASSESSMENT_RECORDING_MAX_CHUNK_MB=25
ASSESSMENT_RECORDING_VIEW_URL_TTL_SECONDS=600

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
LOG_DIR=logs

# Job sharing platforms (leave empty until credentials are available)
# LINKEDIN_API_BASE_URL=
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# LINKEDIN_ACCESS_TOKEN=
# NAUKRI_API_BASE_URL=
# NAUKRI_API_KEY=
# NAUKRI_API_SECRET=
