generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ────────────────────────────────────────────────────────────────────

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ApprovalStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  CLOSED
  ON_HOLD
}

enum RequisitionRaisedFrom {
  DEPARTMENT
  PLANT
  CORPORATE_HEAD_OFFICE
  MANAGEMENT
  OTHER
}

enum JobPositionStatus {
  OPEN
  ON_HOLD
  CLOSED
}

enum CandidateStatus {
  APPLIED
  SCREENING
  SHORTLISTED
  INTERVIEW_ROUND_1
  INTERVIEW_ROUND_2
  HR_ROUND
  SELECTED
  OFFER_SENT
  OFFER_ACCEPTED
  JOINED
  REJECTED
  WITHDRAWN
  ON_HOLD
}

enum InterviewStatus {
  SCHEDULED
  COMPLETED
  SHORTLISTED
  REJECTED
  BACKOUT
  ON_HOLD
  RESCHEDULED
  CANCELLED
  NO_SHOW
}

enum InterviewMode {
  VIDEO
  IN_PERSON
}

enum JoiningStatus {
  PENDING
  JOINED
  ONBOARDING
  COMPLETED
  NOT_JOINED
}

enum EmployeeStatus {
  ACTIVE
  NOTICE_PERIOD
  EXITED
}

enum NoticeStatus {
  NOTICE_STARTED
  NOTICE_IN_PROGRESS
  NOTICE_COMPLETED
  EXITED_EARLY
}

enum InterviewRecommendation {
  STRONGLY_RECOMMENDED
  RECOMMENDED
  NEUTRAL
  NOT_RECOMMENDED
  STRONGLY_NOT_RECOMMENDED
}

enum OfferStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  WITHDRAWN
}

enum NotificationType {
  APPLICATION_RECEIVED
  INTERVIEW_SCHEDULED
  INTERVIEW_REMINDER
  OFFER_SENT
  OFFER_ACCEPTED
  OFFER_REJECTED
  STATUS_CHANGED
  APPROVAL_REQUIRED
  GENERAL
}

// ─── RBAC ─────────────────────────────────────────────────────────────────────

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  displayName String
  description String?
  isSystem    Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users           User[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  resource    String
  action      String
  displayName String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rolePermissions RolePermission[]

  @@unique([resource, action])
  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(uuid())
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

// ─── USERS ────────────────────────────────────────────────────────────────────

model User {
  id             String     @id @default(uuid())
  email          String     @unique
  passwordHash   String
  firstName      String
  lastName       String
  phone          String?
  avatar         String?
  roleId         String
  status         UserStatus @default(ACTIVE)
  departmentId   String?
  lastLoginAt    DateTime?
  emailVerified  Boolean    @default(false)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  deletedAt      DateTime?

  role           Role        @relation(fields: [roleId], references: [id])
  department     Department? @relation("UserPrimaryDepartment", fields: [departmentId], references: [id])
  refreshTokens  RefreshToken[]
  passwordResets PasswordReset[]
  notifications  Notification[]
  departmentAssignments UserDepartment[]
  locationAssignments   UserLocation[]

  // Audit trail
  createdJobs           Job[]                @relation("JobCreatedBy")
  updatedJobs           Job[]                @relation("JobUpdatedBy")
  ownedJobs             Job[]                @relation("JobOwnedBy")
  managedJobs           Job[]                @relation("JobHiringManager")
  createdRequisitions   ManpowerRequisition[] @relation("RequisitionCreatedBy")
  approvedRequisitions  ManpowerRequisition[] @relation("RequisitionApprovedBy")
  scheduledInterviews   Interview[]          @relation("InterviewScheduledBy")
  interviewFeedbacks    InterviewFeedback[]
  assignedInterviews    InterviewInterviewer[]
  createdOffers         Offer[]              @relation("OfferCreatedBy")
  approvedOffers        Offer[]              @relation("OfferApprovedBy")
  candidateNotes        CandidateNote[]
  ownedCandidates       Candidate[]          @relation("CandidateOwnedBy")
  ownedApplications     Application[]        @relation("ApplicationOwnedBy")
  employees             Employee[]           @relation("EmployeeHrOwner")
  jobShares             JobShare[]           @relation("JobShareSharedBy")
  createdAssessments    Assessment[]         @relation("AssessmentCreatedBy")
  assessmentAssignments AssessmentAssignment[] @relation("AssessmentAssignedBy")

  @@map("users")
}

model UserDepartment {
  id           String   @id @default(uuid())
  userId       String
  departmentId String
  createdAt    DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([userId, departmentId])
  @@map("user_departments")
}

model UserLocation {
  id         String   @id @default(uuid())
  userId     String
  locationId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([userId, locationId])
  @@map("user_locations")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  isRevoked Boolean  @default(false)
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model PasswordReset {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_resets")
}

// ─── MASTER DATA ──────────────────────────────────────────────────────────────

model Department {
  id          String    @id @default(uuid())
  name        String    @unique
  code        String    @unique
  description String?
  headId      String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  users                User[]              @relation("UserPrimaryDepartment")
  userAssignments      UserDepartment[]
  jobs                 Job[]
  manpowerRequisitions ManpowerRequisition[]
  employees            Employee[]
  subDepartments       SubDepartment[]

  @@map("departments")
}

model SubDepartment {
  id           String    @id @default(uuid())
  name         String
  code         String?
  description  String?
  departmentId String
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  department           Department            @relation(fields: [departmentId], references: [id])
  manpowerRequisitions ManpowerRequisition[]

  @@unique([departmentId, name])
  @@map("sub_departments")
}

model Designation {
  id                      String    @id @default(uuid())
  name                    String    @unique
  code                    String    @unique
  description             String?
  level                   Int?
  defaultDescription      String?
  defaultResponsibilities String?
  defaultRequirements     String?
  defaultBenefits         String?
  isActive                Boolean   @default(true)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  deletedAt               DateTime?

  jobs                 Job[]
  manpowerRequisitions ManpowerRequisition[]
  employees            Employee[]
  skills               DesignationSkill[]
  assessments          Assessment[]

  @@map("designations")
}

model Location {
  id          String    @id @default(uuid())
  name        String
  city        String
  state       String
  country     String    @default("India")
  pincode     String?
  address     String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  jobs                 Job[]
  manpowerRequisitions ManpowerRequisition[]
  userAssignments      UserLocation[]

  @@map("locations")
}

model EmploymentType {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  jobs Job[]

  @@map("employment_types")
}

model ExperienceLevel {
  id          String    @id @default(uuid())
  name        String    @unique
  minYears    Float
  maxYears    Float?
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  jobs                 Job[]
  manpowerRequisitions ManpowerRequisition[]

  @@map("experience_levels")
}

model Skill {
  id          String    @id @default(uuid())
  name        String    @unique
  category    String?
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  jobSkills            JobSkill[]
  requisitionSkills    RequisitionSkill[]
  candidateSkills      CandidateSkill[]
  designationSkills    DesignationSkill[]

  @@map("skills")
}

model InterviewType {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  interviews Interview[]

  @@map("interview_types")
}

model Education {
  id          String    @id @default(uuid())
  name        String    @unique
  level       Int?
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  candidateEducations CandidateEducation[]

  @@map("educations")
}

model RecruitmentSource {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  candidates  Candidate[]
  applications Application[]

  @@map("recruitment_sources")
}

model Reason {
  id          String    @id @default(uuid())
  name        String
  type        String
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@unique([name, type])
  @@map("reasons")
}

// ─── MANPOWER REQUISITION ─────────────────────────────────────────────────────

model ManpowerRequisition {
  id                String         @id @default(uuid())
  requisitionNumber String         @unique
  departmentId            String
  subDepartmentId         String?
  designationId           String
  locationId              String
  experienceLevelId       String?
  numberOfPositions       Int
  filledPositions         Int                     @default(0)
  salaryMin               Decimal?                @db.Decimal(12, 2)
  salaryMax               Decimal?                @db.Decimal(12, 2)
  jobDescription          String?
  remark                  String?
  priority                Priority                @default(MEDIUM)
  hiringManagerId         String?
  approvalStatus          ApprovalStatus          @default(PENDING)
  approvedById            String?
  approvedAt              DateTime?
  rejectionReason         String?
  targetDate              DateTime?
  replacementAvailable    Boolean                 @default(false)
  replacementEmployeeName String?
  hodName                 String?
  raisedFrom              RequisitionRaisedFrom?
  isActive                Boolean                 @default(true)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  deletedAt         DateTime?
  createdById       String

  department      Department       @relation(fields: [departmentId], references: [id])
  subDepartment   SubDepartment?   @relation(fields: [subDepartmentId], references: [id])
  designation     Designation      @relation(fields: [designationId], references: [id])
  location        Location         @relation(fields: [locationId], references: [id])
  experienceLevel ExperienceLevel? @relation(fields: [experienceLevelId], references: [id])
  createdBy       User             @relation("RequisitionCreatedBy", fields: [createdById], references: [id])
  approvedBy      User?            @relation("RequisitionApprovedBy", fields: [approvedById], references: [id])

  skills RequisitionSkill[]
  jobs   Job[]

  @@map("manpower_requisitions")
}

model RequisitionSkill {
  id             String  @id @default(uuid())
  requisitionId  String
  skillId        String
  isRequired     Boolean @default(true)

  requisition ManpowerRequisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  skill       Skill               @relation(fields: [skillId], references: [id])

  @@unique([requisitionId, skillId])
  @@map("requisition_skills")
}

model DesignationSkill {
  id             String  @id @default(uuid())
  designationId  String
  skillId        String
  isRequired     Boolean @default(true)

  designation Designation @relation(fields: [designationId], references: [id], onDelete: Cascade)
  skill       Skill       @relation(fields: [skillId], references: [id])

  @@unique([designationId, skillId])
  @@map("designation_skills")
}

// ─── JOBS ─────────────────────────────────────────────────────────────────────

model Job {
  id               String          @id @default(uuid())
  title            String
  slug             String          @unique
  departmentId     String
  designationId    String
  locationId       String
  employmentTypeId String?
  experienceLevelId String?
  requisitionId    String?
  description      String
  responsibilities String?
  requirements     String?
  benefits         String?
  salaryMin        Decimal?        @db.Decimal(12, 2)
  salaryMax        Decimal?        @db.Decimal(12, 2)
  showSalary       Boolean         @default(false)
  numberOfPositions Int            @default(1)
  filledPositions  Int             @default(0)
  priority         Priority        @default(MEDIUM)
  positionStatus   JobPositionStatus @default(OPEN)
  isActive         Boolean         @default(true)
  isPublished      Boolean         @default(false)
  publishedAt      DateTime?
  closingDate      DateTime?
  hiringManagerId  String?
  ownedById        String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  deletedAt        DateTime?
  createdById      String
  updatedById      String?

  department      Department      @relation(fields: [departmentId], references: [id])
  designation     Designation     @relation(fields: [designationId], references: [id])
  location        Location        @relation(fields: [locationId], references: [id])
  employmentType  EmploymentType? @relation(fields: [employmentTypeId], references: [id])
  experienceLevel ExperienceLevel? @relation(fields: [experienceLevelId], references: [id])
  requisition     ManpowerRequisition? @relation(fields: [requisitionId], references: [id])
  createdBy       User            @relation("JobCreatedBy", fields: [createdById], references: [id])
  updatedBy       User?           @relation("JobUpdatedBy", fields: [updatedById], references: [id])
  hiringManager   User?           @relation("JobHiringManager", fields: [hiringManagerId], references: [id])
  ownedBy         User?           @relation("JobOwnedBy", fields: [ownedById], references: [id])

  skills                JobSkill[]
  applications          Application[]
  assessments           Assessment[]
  assessmentAssignments AssessmentAssignment[]
  shares                JobShare[]

  @@map("jobs")
}

// ─── JOB SHARING (LinkedIn / Naukri) ─────────────────────────────────────────

enum JobSharePlatform {
  LINKEDIN
  NAUKRI
}

enum JobShareStatus {
  NOT_SHARED
  PENDING
  POSTED
  FAILED
  REMOVED
}

model JobShare {
  id             String           @id @default(uuid())
  jobId          String
  platform       JobSharePlatform
  status         JobShareStatus   @default(NOT_SHARED)
  externalJobId  String?
  externalJobUrl String?
  errorMessage   String?
  sharedAt       DateTime?
  sharedById     String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  job      Job   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  sharedBy User? @relation("JobShareSharedBy", fields: [sharedById], references: [id])
  history  JobShareHistory[]

  @@unique([jobId, platform])
  @@index([jobId])
  @@map("job_shares")
}

model JobShareHistory {
  id             String           @id @default(uuid())
  jobShareId     String
  jobId          String
  platform       JobSharePlatform
  status         JobShareStatus
  action         String
  externalJobId  String?
  externalJobUrl String?
  errorMessage   String?
  actedById      String?
  createdAt      DateTime         @default(now())

  jobShare JobShare @relation(fields: [jobShareId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([jobShareId])
  @@map("job_share_history")
}

model JobSkill {
  id         String  @id @default(uuid())
  jobId      String
  skillId    String
  isRequired Boolean @default(true)

  job   Job   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id])

  @@unique([jobId, skillId])
  @@map("job_skills")
}

// ─── CANDIDATES ───────────────────────────────────────────────────────────────

model Candidate {
  id                   String    @id @default(uuid())
  firstName            String
  lastName             String
  email                String    @unique
  phone                String?
  alternatePhone       String?
  gender               Gender?
  dateOfBirth          DateTime?
  currentLocation      String?
  currentCompany       String?
  currentDesignation   String?
  currentSalary        Decimal?  @db.Decimal(12, 2)
  expectedSalary       Decimal?  @db.Decimal(12, 2)
  totalExperience      Float?
  noticePeriodDays     Int?
  linkedinUrl          String?
  portfolioUrl         String?
  resumeUrl            String?
  resumeOriginalName   String?
  profileSummary       String?
  sourceId             String?
  ownedById            String?
  passwordHash         String?
  lastLoginAt          DateTime?
  isActive             Boolean   @default(true)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  deletedAt            DateTime?

  source       RecruitmentSource? @relation(fields: [sourceId], references: [id])
  ownedBy      User?              @relation("CandidateOwnedBy", fields: [ownedById], references: [id])

  skills              CandidateSkill[]
  educations          CandidateEducation[]
  experiences         CandidateExperience[]
  applications        Application[]
  notes               CandidateNote[]
  tags                CandidateTag[]
  assessmentAttempts    AssessmentAttempt[]
  assessmentAssignments AssessmentAssignment[]
  employees             Employee[]
  refreshTokens         CandidateRefreshToken[]

  @@map("candidates")
}

model CandidateRefreshToken {
  id          String    @id @default(uuid())
  candidateId String
  token       String    @unique
  expiresAt   DateTime
  isRevoked   Boolean   @default(false)
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime  @default(now())

  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@map("candidate_refresh_tokens")
}

model CandidateSkill {
  id          String @id @default(uuid())
  candidateId String
  skillId     String
  yearsOfExp  Float?

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  skill     Skill     @relation(fields: [skillId], references: [id])

  @@unique([candidateId, skillId])
  @@map("candidate_skills")
}

model CandidateEducation {
  id           String    @id @default(uuid())
  candidateId  String
  educationId  String?
  degree       String
  fieldOfStudy String?
  institution  String
  startYear    Int?
  endYear      Int?
  grade        String?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())

  candidate Candidate  @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  education Education? @relation(fields: [educationId], references: [id])

  @@map("candidate_educations")
}

model CandidateExperience {
  id              String    @id @default(uuid())
  candidateId     String
  company         String
  designation     String
  startDate       DateTime
  endDate         DateTime?
  isCurrent       Boolean   @default(false)
  description     String?
  location        String?
  createdAt       DateTime  @default(now())

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@map("candidate_experiences")
}

model CandidateNote {
  id          String   @id @default(uuid())
  candidateId String
  note        String
  createdAt   DateTime @default(now())
  createdById String

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  createdBy User      @relation(fields: [createdById], references: [id])

  @@map("candidate_notes")
}

model CandidateTag {
  id          String @id @default(uuid())
  candidateId String
  tag         String

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([candidateId, tag])
  @@map("candidate_tags")
}

// ─── APPLICATIONS ─────────────────────────────────────────────────────────────

model Application {
  id              String          @id @default(uuid())
  candidateId     String
  jobId           String
  sourceId        String?
  ownedById       String?
  status          CandidateStatus @default(APPLIED)
  coverLetter     String?
  currentStageId  String?
  rejectionReason String?
  appliedAt       DateTime        @default(now())
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  candidate Candidate          @relation(fields: [candidateId], references: [id])
  job       Job                @relation(fields: [jobId], references: [id])
  source    RecruitmentSource? @relation(fields: [sourceId], references: [id])
  ownedBy   User?              @relation("ApplicationOwnedBy", fields: [ownedById], references: [id])

  timeline              ApplicationTimeline[]
  interviews            Interview[]
  offer                 Offer?
  assessmentAssignments AssessmentAssignment[]
  assessmentAttempts    AssessmentAttempt[]
  joiningChecklist      JoiningChecklist?
  employee              Employee?

  @@unique([candidateId, jobId])
  @@map("applications")
}

model ApplicationTimeline {
  id            String          @id @default(uuid())
  applicationId String
  fromStatus    CandidateStatus?
  toStatus      CandidateStatus
  notes         String?
  createdAt     DateTime        @default(now())
  createdById   String?

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("application_timeline")
}

// ─── INTERVIEWS ───────────────────────────────────────────────────────────────

model Interview {
  id              String          @id @default(uuid())
  applicationId   String
  interviewTypeId String?
  round           Int             @default(1)
  title           String
  scheduledAt     DateTime
  durationMinutes Int             @default(60)
  mode            InterviewMode   @default(VIDEO)
  location        String?
  meetingLink     String?
  meetingToken    String?         @unique
  status          InterviewStatus @default(SCHEDULED)
  notes           String?
  scheduledById   String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  application   Application    @relation(fields: [applicationId], references: [id])
  interviewType InterviewType? @relation(fields: [interviewTypeId], references: [id])
  scheduledBy   User           @relation("InterviewScheduledBy", fields: [scheduledById], references: [id])

  interviewersList InterviewInterviewer[]
  feedback     InterviewFeedback[]

  @@map("interviews")
}

model InterviewInterviewer {
  id          String @id @default(uuid())
  interviewId String
  userId      String

  interview Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id])

  @@unique([interviewId, userId])
  @@map("interview_interviewers")
}

model InterviewFeedback {
  id               String                  @id @default(uuid())
  interviewId      String
  interviewerId    String
  technicalRating  Int?
  communicationRating Int?
  problemSolvingRating Int?
  overallRating    Int?
  strengths        String?
  weaknesses       String?
  comments         String?
  recommendation   InterviewRecommendation?
  submittedAt      DateTime                @default(now())
  createdAt        DateTime                @default(now())

  interview   Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  interviewer User      @relation(fields: [interviewerId], references: [id])

  @@unique([interviewId, interviewerId])
  @@map("interview_feedback")
}

// ─── OFFERS ───────────────────────────────────────────────────────────────────

model Offer {
  id              String      @id @default(uuid())
  applicationId   String      @unique
  offerNumber     String      @unique
  status          OfferStatus @default(DRAFT)
  ctc             Decimal     @db.Decimal(12, 2)
  joiningBonus    Decimal?    @db.Decimal(12, 2)
  joiningDate     DateTime?
  designation     String
  department      String
  location        String
  salaryBreakdown Json?
  terms           String?
  expiresAt       DateTime?
  sentAt          DateTime?
  acceptedAt      DateTime?
  rejectedAt      DateTime?
  rejectionReason String?
  approvalStatus  ApprovalStatus @default(PENDING)
  approvedById    String?
  approvedAt      DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  createdById     String

  application Application @relation(fields: [applicationId], references: [id])
  createdBy   User        @relation("OfferCreatedBy", fields: [createdById], references: [id])
  approvedBy  User?       @relation("OfferApprovedBy", fields: [approvedById], references: [id])

  @@map("offers")
}

// ─── JOINING & EMPLOYEE ───────────────────────────────────────────────────────

model JoiningChecklist {
  id            String        @id @default(uuid())
  applicationId String        @unique
  joiningDate   DateTime?
  employeeCode  String?
  status        JoiningStatus @default(PENDING)
  documents     Json          @default("[]")
  checklistItems Json         @default("[]")
  isCompleted   Boolean       @default(false)
  completedAt   DateTime?
  remarks       String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("joining_checklists")
}

model Employee {
  id              String         @id @default(uuid())
  applicationId   String         @unique
  candidateId     String
  departmentId    String
  designationId   String
  hrOwnerId       String?
  employeeCode    String?        @unique
  joinedAt        DateTime
  status          EmployeeStatus @default(ACTIVE)
  noticeStartDate DateTime?
  noticeEndDate   DateTime?
  noticeStatus    NoticeStatus?
  exitReason      String?
  exitedAt        DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  application Application @relation(fields: [applicationId], references: [id])
  candidate   Candidate   @relation(fields: [candidateId], references: [id])
  department  Department  @relation(fields: [departmentId], references: [id])
  designation Designation @relation(fields: [designationId], references: [id])
  hrOwner     User?       @relation("EmployeeHrOwner", fields: [hrOwnerId], references: [id])

  @@map("employees")
}

// ─── ASSESSMENTS ──────────────────────────────────────────────────────────────

enum QuestionType {
  MCQ
  TEXT
  TRUE_FALSE
  MULTIPLE_SELECT
  SHORT_ANSWER
  CODING
  DESCRIPTIVE
}

enum AssessmentStatus {
  DRAFT
  ACTIVE
  CLOSED
}

enum AssignmentStatus {
  ASSIGNED
  STARTED
  COMPLETED
  EXPIRED
  CANCELLED
}

model Assessment {
  id             String           @id @default(uuid())
  name           String
  description    String?
  jobId          String
  designationId  String?
  durationMins   Int              @default(30)
  passingScore   Int              @default(60)
  maxAttempts    Int              @default(1)
  startAt        DateTime?
  endAt          DateTime?
  status         AssessmentStatus @default(DRAFT)
  createdById    String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  deletedAt      DateTime?

  job           Job                     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  designation   Designation?            @relation(fields: [designationId], references: [id])
  createdBy     User                    @relation("AssessmentCreatedBy", fields: [createdById], references: [id])
  questions     AssessmentQuestion[]
  assignments   AssessmentAssignment[]
  attempts      AssessmentAttempt[]

  @@index([jobId])
  @@index([status])
  @@map("assessments")
}

model AssessmentQuestion {
  id           String       @id @default(uuid())
  assessmentId String
  questionText String
  questionType QuestionType @default(MCQ)
  options      Json?
  correctAnswer String?
  marks        Int          @default(1)
  displayOrder Int          @default(0)
  isActive     Boolean      @default(true)
  explanation  String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  assessment Assessment         @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  optionItems AssessmentOption[]
  answers    AssessmentAnswer[]

  @@index([assessmentId])
  @@map("assessment_questions")
}

model AssessmentOption {
  id           String  @id @default(uuid())
  questionId   String
  optionText   String
  isCorrect    Boolean @default(false)
  displayOrder Int     @default(0)

  question AssessmentQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@map("assessment_options")
}

model AssessmentAssignment {
  id            String           @id @default(uuid())
  assessmentId  String
  candidateId   String
  applicationId String
  jobId         String
  assignedById  String
  assignedAt    DateTime         @default(now())
  status        AssignmentStatus @default(ASSIGNED)
  maxAttempts   Int              @default(1)
  secureToken   String           @unique
  expiresAt     DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  assessment  Assessment          @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  candidate   Candidate           @relation(fields: [candidateId], references: [id])
  application Application         @relation(fields: [applicationId], references: [id])
  job         Job                 @relation(fields: [jobId], references: [id])
  assignedBy  User                @relation("AssessmentAssignedBy", fields: [assignedById], references: [id])
  attempts    AssessmentAttempt[]

  @@unique([assessmentId, applicationId])
  @@index([assessmentId])
  @@index([candidateId])
  @@index([secureToken])
  @@map("assessment_assignments")
}

model AssessmentAttempt {
  id            String    @id @default(uuid())
  assessmentId  String
  assignmentId  String?
  candidateId   String
  applicationId String
  attemptNumber Int       @default(1)
  startedAt     DateTime  @default(now())
  submittedAt   DateTime?
  score         Int?
  totalMarks    Int?
  obtainedMarks Int?
  isPassed      Boolean?
  isTimedOut    Boolean   @default(false)
  recordingConsent   Boolean   @default(false)
  recordingConsentAt DateTime?
  createdAt     DateTime  @default(now())

  assessment        Assessment                 @relation(fields: [assessmentId], references: [id])
  assignment        AssessmentAssignment?      @relation(fields: [assignmentId], references: [id])
  candidate         Candidate                  @relation(fields: [candidateId], references: [id])
  application       Application                @relation(fields: [applicationId], references: [id])
  answers           AssessmentAnswer[]
  questionSnapshots AssessmentAttemptQuestion[]
  recordings        AssessmentRecording[]
  recordingEvents   AssessmentRecordingEvent[]

  @@index([applicationId])
  @@index([assignmentId])
  @@unique([assignmentId, attemptNumber])
  @@map("assessment_attempts")
}

enum RecordingType {
  CAMERA
  SCREEN
}

enum RecordingStatus {
  UPLOADING
  PROCESSING
  READY
  FAILED
  DELETED
}

model AssessmentRecording {
  id              String          @id @default(uuid())
  attemptId       String
  assignmentId    String?
  candidateId     String
  assessmentId    String
  recordingType   RecordingType
  storageKey      String
  mimeType        String?
  fileSize        Int?
  durationSeconds Int?
  chunkCount      Int             @default(0)
  status          RecordingStatus @default(UPLOADING)
  startedAt       DateTime?
  endedAt         DateTime?
  expiresAt       DateTime?
  failureReason   String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  attempt AssessmentAttempt          @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  chunks  AssessmentRecordingChunk[]
  events  AssessmentRecordingEvent[]

  @@unique([attemptId, recordingType])
  @@index([attemptId])
  @@index([assignmentId])
  @@index([candidateId])
  @@index([status])
  @@index([expiresAt])
  @@map("assessment_recordings")
}

model AssessmentRecordingChunk {
  id          String   @id @default(uuid())
  recordingId String
  chunkIndex  Int
  storageKey  String
  byteSize    Int      @default(0)
  uploadedAt  DateTime @default(now())

  recording AssessmentRecording @relation(fields: [recordingId], references: [id], onDelete: Cascade)

  @@unique([recordingId, chunkIndex])
  @@index([recordingId])
  @@map("assessment_recording_chunks")
}

model AssessmentRecordingEvent {
  id          String   @id @default(uuid())
  attemptId   String
  recordingId String?
  eventType   String
  message     String?
  createdAt   DateTime @default(now())

  attempt   AssessmentAttempt    @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  recording AssessmentRecording? @relation(fields: [recordingId], references: [id], onDelete: SetNull)

  @@index([attemptId])
  @@index([recordingId])
  @@map("assessment_recording_events")
}

model AssessmentAttemptQuestion {
  id                 String   @id @default(uuid())
  attemptId          String
  originalQuestionId String?
  questionText       String
  questionType       QuestionType @default(MCQ)
  marks              Int      @default(1)
  displayOrder       Int      @default(0)
  createdAt          DateTime @default(now())

  attempt AssessmentAttempt         @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  options AssessmentAttemptOption[]
  answers AssessmentAnswer[]

  @@index([attemptId])
  @@map("assessment_attempt_questions")
}

model AssessmentAttemptOption {
  id               String  @id @default(uuid())
  attemptQuestionId String
  originalOptionId String?
  optionText       String
  isCorrect        Boolean @default(false)
  displayOrder     Int     @default(0)

  attemptQuestion AssessmentAttemptQuestion @relation(fields: [attemptQuestionId], references: [id], onDelete: Cascade)
  answers         AssessmentAnswer[]

  @@index([attemptQuestionId])
  @@map("assessment_attempt_options")
}

model AssessmentAnswer {
  id                String   @id @default(uuid())
  attemptId         String
  questionId        String?
  attemptQuestionId String?
  selectedOptionId  String?
  answerText        String?
  isCorrect         Boolean?
  marksGiven        Int?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  attempt         AssessmentAttempt          @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question        AssessmentQuestion?        @relation(fields: [questionId], references: [id])
  attemptQuestion AssessmentAttemptQuestion? @relation(fields: [attemptQuestionId], references: [id])
  selectedOption  AssessmentAttemptOption?   @relation(fields: [selectedOptionId], references: [id])

  @@unique([attemptId, questionId])
  @@unique([attemptId, attemptQuestionId])
  @@map("assessment_answers")
}

// ─── EMAIL TEMPLATES ─────────────────────────────────────────────────────────

model EmailTemplate {
  id          String   @id @default(uuid())
  name        String   @unique
  subject     String
  body        String
  category    String?
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("email_templates")
}

// ─── NOTIFICATIONS ────────────────────────────────────────────────────────────

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  data      Json?
  isRead    Boolean          @default(false)
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

// ─── AUDIT LOGS ───────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  resource   String
  resourceId String?
  oldValues  Json?
  newValues  Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@map("audit_logs")
}
