# Production environment template for the VPS deployment.
#
# Copy this to backend/.env on the VPS and fill in every <PLACEHOLDER>:
#   cp backend/.env.production.example backend/.env
#
# Generate strong random secrets (32+ chars each) with:
#   openssl rand -base64 48
# Run it three times for JWT_ACCESS_SECRET, JWT_REFRESH_SECRET, and COOKIE_SECRET.
# Never reuse secrets from another app/site on this VPS.

# Application
NODE_ENV=production
PORT=<BACKEND_PORT>
API_PREFIX=/api/v1

# Database (isolated DB + user created for this app, see deploy/DEPLOY.md "Database" step)
DATABASE_URL="postgresql://hiring_user:<DB_PASSWORD>@localhost:5432/hiring_db?schema=public"

# JWT (generate with: openssl rand -base64 48)
JWT_ACCESS_SECRET=<GENERATE_32PLUS_CHAR_SECRET>
JWT_REFRESH_SECRET=<GENERATE_32PLUS_CHAR_SECRET>
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cookie (generate with: openssl rand -base64 48)
COOKIE_SECRET=<GENERATE_SECRET>

# Frontend — public URL users hit in the browser (used for CORS + links in emails)
FRONTEND_URL=http://<VPS_IP>:<FRONTEND_PORT>

# Email (SMTP) — use real production credentials, e.g. an app password or transactional email provider
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=<PRODUCTION_EMAIL>
SMTP_PASS=<PRODUCTION_EMAIL_APP_PASSWORD>
EMAIL_FROM="Hiring System <noreply@yourcompany.com>"

# Storage — persistent directory for resumes/uploads, do NOT delete on redeploy
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
LOG_DIR=logs

# Job sharing platforms (leave empty until credentials are available)
# LINKEDIN_API_BASE_URL=
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# LINKEDIN_ACCESS_TOKEN=
# NAUKRI_API_BASE_URL=
# NAUKRI_API_KEY=
# NAUKRI_API_SECRET=
