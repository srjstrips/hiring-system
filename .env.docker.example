# Docker Compose environment file template.
#
# Copy this to ".env" at the repo root (same directory as docker-compose.yml)
# and fill in every <PLACEHOLDER>. `docker compose` loads ".env" automatically.
#
#   cp .env.docker.example .env
#
# Generate strong random secrets (32+ chars each) with:
#   openssl rand -base64 48
# Run it separately for POSTGRES_PASSWORD, JWT_ACCESS_SECRET, JWT_REFRESH_SECRET,
# and COOKIE_SECRET. Never reuse secrets from another app/site on this VPS.

# Postgres (internal-only container, not published to the host)
POSTGRES_USER=hiring_user
POSTGRES_PASSWORD=<GENERATE_STRONG_PASSWORD>
POSTGRES_DB=hiring_db

# JWT
JWT_ACCESS_SECRET=<GENERATE_32PLUS_CHAR_SECRET>
JWT_REFRESH_SECRET=<GENERATE_32PLUS_CHAR_SECRET>
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cookie
COOKIE_SECRET=<GENERATE_SECRET>

# Public URL users hit in the browser -- must match the published "web" port (3005)
# and is used for CORS in backend/src/app.ts, so it must match exactly.
FRONTEND_URL=http://<VPS_IP>:3005

# Email (SMTP) -- use real production credentials
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=<PRODUCTION_EMAIL>
SMTP_PASS=<PRODUCTION_EMAIL_APP_PASSWORD>
EMAIL_FROM="Hiring System <noreply@yourcompany.com>"

# Uploads / rate limiting / logging (defaults are usually fine)
MAX_FILE_SIZE_MB=10
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
LOG_LEVEL=info

# Job sharing platforms (leave empty until credentials are available)
LINKEDIN_API_BASE_URL=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=
NAUKRI_API_BASE_URL=
NAUKRI_API_KEY=
NAUKRI_API_SECRET=
